# Copy to `.env` and fill in to run against real models.
# Without these, the repo runs on the dependency-free MockLLM.

# ── OpenAI ──────────────────────────────────────────────
# Set to 1 to use the real OpenAI client instead of the MockLLM.
USE_OPENAI=

# Your OpenAI API key (required only when USE_OPENAI=1).
OPENAI_API_KEY=

# Optional: point at any OpenAI-compatible endpoint (Ollama, vLLM, etc.).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional model overrides (defaults shown).
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ── DeepSeek ────────────────────────────────────────────
# DeepSeek's API is fully OpenAI-compatible.  Set your key and use
# DeepSeekLLM instead of OpenAILLM:
#
#     from agent import DeepSeekLLM
#     llm = DeepSeekLLM()                 # deepseek-chat (V3)
#     llm = DeepSeekLLM(model="deepseek-reasoner")  # DeepSeek-R1

# Your DeepSeek API key (https://platform.deepseek.com/api_keys).
DEEPSEEK_API_KEY=

# DeepSeek base URL (default shown — usually no need to change).
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 百炼 (Alibaba Bailian / DashScope) ────────────────────
# 百炼 API 完全兼容 OpenAI 协议。设置 BAILIAN_API_KEY 后使用
# BailianLLM 即可自动走百炼的 chat + embedding：
#
#     from agent import BailianLLM
#     llm = BailianLLM()                    # qwen-plus + text-embedding-v3
#     llm = BailianLLM(model="qwen-max")    # 切换模型
#     llm = BailianLLM(embed_model="text-embedding-v4")  # 切换 embedding 模型
#
# embedding 模型用于 LongTermMemory / SQLiteVectorStore 的向量检索。

# 你的百炼 API key (https://bailian.console.aliyun.com)。
BAILIAN_API_KEY=

# 百炼 base URL (默认值如下，通常无需修改)。
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 百炼 embedding 模型 (用于 LongTermMemory / SQLiteVectorStore 向量检索)。
# BAILIAN_EMBED_MODEL=text-embedding-v3

# ── Fetch MCP ───────────────────────────────────────────
# Explicit opt-in: Fetch can reach local/internal network addresses.
ENABLE_FETCH_MCP=0

# After reviewing the risk, install uv and set ENABLE_FETCH_MCP=1.
# Install uv with: python -m pip install uv
MCP_FETCH_CONNECT_TIMEOUT=90
MCP_FETCH_CALL_TIMEOUT=60

# ── Governed medical RAG ───────────────────────────────
# Disabled by default. Put UTF-8 .md/.txt sources in RAG_SOURCE_DIR.
ENABLE_RAG=0
RAG_SOURCE_DIR=data/rag_sources
RAG_DB_PATH=data/rag.sqlite
RAG_DEFAULT_PUBLISHER=local-corpus
RAG_DEFAULT_JURISDICTION=CN
RAG_MAX_DOCUMENT_BYTES=5242880

# Required for POST /api/rag/documents. Keep this secret and restrict the API
# at the network layer as well; unauthenticated corpus writes enable poisoning.
RAG_ADMIN_TOKEN=

# Dedicated OpenAI-compatible embedding endpoint (required when enabled).
RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1

# ── Local workspace tools ──────────────────────────────
# File tools are constrained to AGENT_WORKSPACE_ROOT. CLI execution is a
# stronger capability and should only be enabled for a trusted local user.
ENABLE_LOCAL_FILE_TOOLS=0
ENABLE_LOCAL_CLI=0
AGENT_WORKSPACE_ROOT=C:\path\to\your\workspace
AGENT_FILE_MAX_READ_BYTES=2097152
AGENT_FILE_MAX_WRITE_BYTES=2097152
AGENT_CLI_ALLOWED_COMMANDS=git,rg,python,python.exe,pytest
AGENT_CLI_TIMEOUT_SECONDS=30
AGENT_CLI_MAX_OUTPUT_BYTES=262144

# ── Tool-scaling experiment kit (examples/tool_scaling_kit.py) ─────────
# Opt-in: registers up to 100 extra math/text/date/convert/data/stat/format/
# calendar/measure/encode tools so the live agent (and the web UI) can be
# exercised at a larger tool count, same kit used by examples/tool_scaling_test.py.
# Off by default -- leave it off for normal use.
ENABLE_TOOL_SCALING_KIT=0
# 1 = ~6.5x-longer, deliberately repetitive descriptions (see
# examples/tool_scaling_verbose_kit.py); 0 = concise descriptions.
TOOL_SCALING_KIT_VERBOSE=0
# How many of the 100 kit tools to register (1-100).
TOOL_SCALING_KIT_SIZE=100

# ── Logging / observability ─────────────────────────────
# json is best for log collectors; text is easier to scan locally.
AGENT_LOG_LEVEL=INFO
AGENT_LOG_FORMAT=json

# Optional rotating file. Empty means stderr only.
# AGENT_LOG_FILE=logs/agent.log
# AGENT_LOG_MAX_BYTES=10485760
# AGENT_LOG_BACKUP_COUNT=5
# AGENT_LOG_MAX_FIELD_CHARS=1000
